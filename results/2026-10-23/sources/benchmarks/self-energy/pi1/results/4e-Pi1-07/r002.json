  "I": {
    "kind": "explicit convergent mixed-exponent series plus MeijerG",
    "sympy_template": "-((Tmixed_sum + (H03 - 2*H2m*sinh(eps*log(z)) + (H01 - 2*H2p)*cosh(eps*log(z)))/(2*eps*(eps + 1)))*exp(-3*EulerGamma*eps)*gamma(1 - eps)**3/(128*eps*(1 - 2*eps)*cosh(3*eps*log(z)/2)))",
    "bindings": {
      "Tmixed_sum": "T(2eps,eps,z)+T(eps,2eps,z)",
      "H03": "H0(3eps,z)",
      "H01": "H0(eps,z)",
      "H2p": "(H2(eps,z)+H2(eps,1/z))/2",
      "H2m": "(H2(eps,z)-H2(eps,1/z))/2"
    },
    "series": {
      "T(a,b,z)": "((1+z)/sqrt(z))^(a+b)*Sum[(1-a)_k*(1-b)_l/(k!*l!)*B(k,l,z),{k,0,infinity},{l,0,infinity}]",
      "B(k,l,z)": "Sum[p_k(i,j;z)*p_l(m,n;z)/((i+1)*(i+m+2)*(j+1)*(j+n+2)),{i,j=0..k},{m,n=0..l}]",
      "p_k(i,j;z)": "Sum[k!*(-1)^h*z^(k-i-j+h)/((k-i-j+h)!*(i-h)!*(j-h)!*h!*(1+z)^(k-h)),{h,max(0,i+j-k),min(i,j)}]",
      "order": "each finite B block first, then the double sum; no arbitrary rearrangement of signed monomials",
      "domain": "z>0, initially 0<Re(eps)<1/2 with a=2eps,b=eps; locally normally convergent near eps=0"
    },
    "latex": "- \\frac{\\left(Tmixed_{sum} + \\frac{H_{03} - 2 H2m \\sinh{\\left(eps \\log{\\left(z \\right)} \\right)} + \\left(H_{01} - 2 H2p\\right) \\cosh{\\left(eps \\log{\\left(z \\right)} \\right)}}{2 eps \\left(eps + 1\\right)}\\right) e^{- 3 \\gamma eps} \\Gamma^{3}\\left(1 - eps\\right)}{128 eps \\left(1 - 2 eps\\right) \\cosh{\\left(\\frac{3 eps \\log{\\left(z \\right)}}{2} \\right)}}"
  },
