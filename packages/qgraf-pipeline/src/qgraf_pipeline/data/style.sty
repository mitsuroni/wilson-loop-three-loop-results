% QGRAF style file — mathematica-like output
<output>
  <diagram>
    % diagram `counter'
    amp(`counter') = (`sign')*(`symmetry_factor')*
    <back>
      <propagator>
        prop(`field1', `field2', `momentum')*
      </propagator>
      <vertex>
        vert(<field><momentum><back><field>`, '<momentum>'</back></field>, </vertex>)*
    </back>
    1;
  </diagram>
</output>
