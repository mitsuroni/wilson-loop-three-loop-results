  "full_epsilon_I": "-exp(-3*EulerGamma*eps)*gamma(2-3*eps)/(16*eps^2)*(K_series(z,eps)+z^(3*eps)*K_series(1/z,eps))/(1+z^(3*eps))",
  "full_epsilon_representation": "Explicit, absolutely convergent Dirichlet-Beta series, every finite block integrated",
  "definitions": {
    "D": "(1-x)*(1-y)+z*x*y",
    "S": "beta1*beta2*(1-x)*u+beta1*beta3*D+z*beta2*beta3*(1-u)*y",
    "P": "(beta1*beta2*(-(1+z)*(1-x)+z*u)+beta1*beta3*(1+3*z-(1+z)*x+z*(1+z)*y)+z*beta2*beta3*(1-u-(1+z)*y))/4",
    "Lambda": "1+z",
    "p": "2-3*eps",
    "b": "beta(1-eps,1-eps)",
    "d_n_i_j_k_a_b_c": "Coefficient of x^i*u^j*y^k*beta1^a*beta2^b*beta3^c in the finite polynomial P*(Lambda-S)^n",
    "D_a_b_c": "gamma(a+1-eps)*gamma(b+1-eps)*gamma(c+1-2*eps)/gamma(a+b+c+3-4*eps)",
    "m_i_j_k": "(beta(k+1-eps,1-eps)-b/(k+1))/((i+1)*(j+1))",
    "B_n": "Lambda^(-n)*sum(d_n_i_j_k_a_b_c*D_a_b_c*m_i_j_k, all finite monomials)",
    "K_series": "Lambda^(-p)*sum(pochhammer(p,n)/factorial(n)*B_n,n=0..infinity)",
    "J13": "2*K_series(z,eps)/eps^2",
    "J22": "z^(3*eps)*J13(1/z,eps)",
    "notation": "All finite monomial indices are nonnegative integers; beta is Euler beta; beta1,beta2,beta3 are simplex parameters; every block is completely integrated."
  },
